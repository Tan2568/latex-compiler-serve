# Auto detect text files and perform LF normalization
* text=auto

# LaTeX files
*.tex text eol=lf
*.bib text eol=lf
*.cls text eol=lf
*.sty text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.eps binary
